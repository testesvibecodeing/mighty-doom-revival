# Proprietary game files - never commit
*.apk
*.xapk
*.apks
*.aab
input/
output/
work/
decompiled/
jadx-out/
dump/
original/

# External upstream checkout
server/community/

# Local downloaded tooling
.tools/

# Unity / reverse engineering generated data
*.assets.resS
il2cpp-output/
Il2CppDumper-output/

# Local certificates / signing material
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
*.png
*.jpg
*.jpeg
!docs/examples/*.pem.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
.env

# Revival server local/runtime data
server/runtime/
server/data/*
!server/data/README.md
server/config/revival.json
server/config/packs.json
server/config/events.json
server/config/site.json
server/config/smtp.json
server/.env
reports/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db


# Claude Code local/personal settings (per-machine, not team-shared).
# Usamos ".claude/*" (e nao ".claude/") para conseguir liberar as skills:
# o git nao reinclui arquivo cujo diretorio pai esta excluido.
.claude/*
.claude/settings.local.json
# Skills do projeto sao versionadas (contrato de trabalho, nao config pessoal).
!.claude/skills/

# Logs / temporary files
*.log
*.tmp
*.bak

# Estado de deploy da VPS (gerado por scripts/install.sh e scripts/uninstall.sh)
deploy/logs/
deploy/.install-state

# Ícones do jogo extraídos localmente do APK (scripts/extract-game-icons.py).
# Nunca commitados: são assets do jogo obtidos da cópia local do usuário.
# Os SVGs originais em server/public/assets/img/kinds/ são do Revival e ficam versionados.
server/public/assets/img/game/

# arquivos estacionados fora do versionamento (limpezas de scripts/)
tmp/

# Entrada local opcional para o fundo da RevivalAuthActivity (imagem, nunca
# versionada — regra 1 do AGENTS.md). scripts/revival_auth/build.py lê daqui
# em build time e embute como base64 no dex; ausente = fundo solido no app.
scripts/revival_auth/local_assets/*
!scripts/revival_auth/local_assets/README.md
